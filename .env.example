# Required
TELEGRAM_BOT_TOKEN=
GEMINI_API_KEY=

# Optional — encrypts stored Garmin credentials. Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# Calendar subscription URL base (your Railway public domain)
# Example: https://your-app.up.railway.app
CALENDAR_BASE_URL=

# User timezone (IANA format). Defaults to America/Mexico_City
USER_TIMEZONE=America/Mexico_City

# Legacy (only used by sync.py CLI, not needed for multi-user bot)
GARMIN_EMAIL=your_email@example.com
GARMIN_PASSWORD=your_password
